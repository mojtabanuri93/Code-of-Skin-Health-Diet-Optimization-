iter iteration /1*11/


tp1       set     N+(t)  maximum is limited      /20, 21, 22, 25, 26, 30/
tp2       set     N+(t)  maximum is NOT limited  /28, 29/

;

parameter alfa, result(iter,*);
alfa=-0.05;


parameter  a(n,f),a_tp1(tp1,f),a_tp2(tp2,f);

