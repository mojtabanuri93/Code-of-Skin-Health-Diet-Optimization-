parameter budget,epsilon,tao,Mi,cost1,cost2;
budget=8;
epsilon=0;
tao=0;
Mi=1000000000;

parameter p1,p2,p3,p4;
p1=6.300;
p2=2250.392;
p3=2567.986;
p4=2558.996;

variables
OBJ

ob21
ob22(tp2)

;

binary variable

k(f)
v(s)
;


nonnegative variable

x(f)
r(s)
z(n)


kesi(f)
eta(s)
;


equations

objective


co217
co218
co219
co220
co221
co222
co223
co224
co225
co226
co227
co228
co229
co230
co231

;


objective..               OBJ=e=(ob21/p1)+((ob22('28')+z('28'))/p2)+((ob22('29')+z('29'))/(p3-p4));

co217..                   ob21=l=sum((tp1,f),(a_tp1(tp1,f)*kesi(f))/u_tp1(tp1))+sum((tp1,s),(b_tp1(tp1,s)*eta(s))/u_tp1(tp1))+z('20')/u_tp1('20')+z('21')/u_tp1('21')+z('22')/u_tp1('21')+z('25')/u_tp1('25')+z('26')/u_tp1('26')+z('30')/u_tp1('30');

co218(tp2)..              ob22(tp2)=l=sum(f,a_tp2(tp2,f)*kesi(f))+sum(s,b_tp2(tp2,s)*eta(s));

co219(n)..                sum(f,a(n,f)*kesi(f))+sum(s,b(n,s)*eta(s))+z(n)=g=l(n);

co220(n)..                sum(f,a(n,f)*kesi(f))+sum(s,b(n,s)*eta(s))+z(n)=l=u(n);

co221..                   sum(f,cf(f)*x(f))+sum(s,cs(s)*r(s))+sum(n,cn(n)*z(n))=l=budget;

co222(s)..                r(s)=l=2;

co223..                   sum(s,v(s))=g=tao;

co224(s)..                eta(s)=l=Mi*v(s);

co225(s)..                eta(s)=g=Mi*(v(s)-1)+r(s);

co226(s)..                eta(s)=l=r(s);

co227(f)..                x(f)=l=up(f);

co228..                   sum(f,k(f))=g=epsilon;

co229(f)..                kesi(f)=l=Mi*k(f);

co230(f)..                kesi(f)=g=Mi*(k(f)-1)+x(f);

co231(f)..                kesi(f)=l=x(f);




model LPmetric /objective,co217,co218,co219,co220,co221,co222,co223,co224,co225,co226,co227,co228,co229,co230,co231/
option optca=0,optcr=0,reslim=3600,MIP=cplex;



loop(iter,

alfa=alfa+0.05;

** less or equal to 0.5
a_tp1(tp1,f) =2*alfa*a2_tp1(tp1,f) +(1-2*alfa)*a3_tp1(tp1,f);
a_tp2(tp2,f) =2*alfa*a2_tp2(tp2,f) +(1-2*alfa)*a3_tp2(tp2,f);
a(n,f)=(1-2*alfa)*a1(n,f)+2*alfa*a2(n,f);
*for upper constraint


** more than 0.5
*a_tp1(tp1,f) =(2*alfa-1)*a1_tp1(tp1,f) +(2-2*alfa)*a2_tp1(tp1,f);
*a_tp2(tp2,f) =(2*alfa-1)*a1_tp2(tp2,f) +(2-2*alfa)*a2_tp2(tp2,f);
*a(n,f)=(2-2*alfa)*a2(n,f)+(2*alfa-1)*a3(n,f);
*for upper constraint


solve LPmetric maximizing OBJ using MIP;


result(iter,'alfa')=alfa;
result(iter,'cost')=sum(f,cf(f)*x.l(f))+sum(s,cs(s)*r.l(s))+sum(n,cn(n)*z.l(n));
result(iter,'cost-Food')=sum(f,cf(f)*x.l(f));
